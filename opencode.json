{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "causal-docs": {
      "type": "remote",
      "url": "http://localhost:8801",
      "enabled": true
    },
    "graph-math": {
      "type": "remote",
      "url": "http://localhost:8802",
      "enabled": true
    },
    "jupyter-runner": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "opencode_causal.jupyter_runner"
      ],
      "enabled": true
    },
    "causal-sdk": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "opencode_causal.causal_sdk"
      ],
      "enabled": true
    }
  }
}
